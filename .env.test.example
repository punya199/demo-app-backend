# Copy to .env.test (git-ignored). Loaded by yarn test:integration / test:e2e via node --env-file; wins over .env.
# Matches the postgres-test service in docker-compose.yml (yarn test:db:up).
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=yaya_test
DATABASE_PASSWORD=yaya_test
DATABASE_NAME=yaya_test
DATABASE_SSL=false
